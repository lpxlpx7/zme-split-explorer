{
  "name": "zme-split-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "data": "tsx tools/build-data.ts",
    "serve": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=server/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsts": "^2.12.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "mysql2": "^3.24.6"
  }
}
